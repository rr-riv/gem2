#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&mt LCTRL Q       &kp W        &kp E          &kp R      &lt 4 T      &kp Y        &kp U     &kp I         &kp O      &kp P
&mt LEFT_SHIFT A  &kp S        &lt 3 D        &kp F      &kp G        &kp H        &lt 4 J   &kp K         &kp L      &mt LEFT_SHIFT MINUS
&lt 4 Z           &kp X        &kp C          &kp V      &kp B        &kp N        &kp M     &kp DOT       &kp COMMA  &mt LEFT_ALT DOT
&kp LGUI          &kp PAGE_UP  &kp PAGE_DOWN  &mkp LCLK  &lt 2 SPACE  &lt 2 ENTER  &kp LEFT  &kp UP_ARROW  &kp DOWN   &kp RIGHT
            >;
        };

        layer_3 {
            bindings = <
&mt LCTRL Q   &kp L     &kp U    &kp COMMA  &kp PERIOD   &kp F        &kp W     &kp R      &kp Y         &kp P
&kp E         &kp I     &lt 3 A  &kp O      &kp MINUS    &kp K        &kp T     &kp N      &kp S         &kp H
&lt 4 Z       &kp X     &kp C    &kp V      &kp SLASH    &kp G        &kp D     &kp M      &kp J         &kp B
&kp LEFT_WIN  &kp HOME  &kp END  &mkp RCLK  &lt 2 SPACE  &lt 2 ENTER  &kp LEFT  &kp RIGHT  &kp LEFT_ALT  &to 0
            >;
        };

        layer_1 {
            bindings = <
&kp TAB                &kp HASH      &kp EXCL       &kp AT     &kp LBKT   &kp N7             &kp N8  &kp N9  &kp N0     &kp BACKSPACE
&mt LEFT_SHIFT ESCAPE  &kp QUESTION  &kp AMPERSAND  &kp APOS   &kp RBKT   &kp N4             &kp N5  &kp N6  &kp SLASH  &mt LEFT_SHIFT EQUAL
&kp LG(Z)              &kp LG(X)     &kp LG(C)      &kp LG(V)  &kp COLON  &kp N1             &kp N2  &kp N3  &kp PLUS   &kp ASTRK
&kp LEFT_GUI           &kp HOME      &kp END        &mkp RCLK  &mkp LCLK  &kp LC(SEMICOLON)  &none   &none   &none      &kp INT2
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &none         &none           &mmv MOVE_UP    &none            &none  &none
&none           &mkp MB4      &none         &mkp RCLK       &mkp LCLK     &mmv MOVE_LEFT  &none           &mmv MOVE_RIGHT  &none  &none
&none           &none         &none         &msc SCRL_DOWN  &msc SCRL_UP  &none           &mmv MOVE_DOWN  &none            &none  &none
&none           &mkp MB4      &none         &mkp RCLK       &mkp LCLK     &bt BT_NXT      &none           &none            &none  &none
            >;
        };

        layer_4 {
            bindings = <
&to 0        &to 1          &trans        &trans        &trans        &trans    &kp UP_ARROW  &trans     &trans  &trans
&kp PAGE_UP  &kp PAGE_DOWN  &trans        &trans        &trans        &kp LEFT  &trans        &kp RIGHT  &trans  &trans
&trans       &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &trans    &kp DOWN      &trans     &trans  &trans
&trans       &trans         &trans        &trans        &trans        &trans    &trans        &trans     &trans  &trans
            >;
        };
    };
};
